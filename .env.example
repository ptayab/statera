# Copy to .env.local and fill in values from Supabase → Project Settings → API.
# Never commit .env.local — it is gitignored.

# Required for local dev and Vercel production/preview deploys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Future stages (not needed until AI/email features ship):
# ANTHROPIC_API_KEY=
# RESEND_API_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
